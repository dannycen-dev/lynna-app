{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nivel superior = LOCAL (`wrangler dev`). Los entornos remotos están en "env":
  //   dev  → lynna-api-dev   https://devlynna.igniastudio.mx  (se despliega solo al hacer push a main)
  //   stg  → lynna-api-stg   https://stglynna.igniastudio.mx  (tag v*)
  //   prod → lynna-api-prod  https://lynna.igniastudio.mx     (tag v*, con aprobación manual en GitHub)
  // Custom Domains: Cloudflare crea el DNS y el certificado. Sin *.workers.dev (una sola URL por entorno).
  // Bindings, vars y secretos NO se heredan entre entornos: cada uno los declara completos.
  "name": "lynna-api",
  "main": "src/index.ts",
  // Debe ser <= a la fecha que soporta el workerd de wrangler Y el de vitest-pool-workers.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Cuenta Cloudflare de Ignia Studio. Fijarla evita desplegar por error en otra cuenta.
  "account_id": "76d4525e9674ff3e597084e012f8619e", // Ignia Studio
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,

  // Interfaz (apps/web, compilada con Vite). El Worker atiende primero API, webhook y media;
  // todo lo demás son archivos estáticos con fallback a index.html (SPA).
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/whatsapp/*", "/media/*", "/health"]
  },

  "vars": {
    "ENVIRONMENT": "local",
    // URL pública del entorno: Meta descarga de aquí las fotos y planos (/media/:id) que manda Lynna.
    "PUBLIC_URL": "http://localhost:8787",
    "WHATSAPP_GRAPH_VERSION": "v23.0",
    // Ventana para agrupar ráfagas de mensajes del mismo prospecto antes de responder.
    "DEBOUNCE_MS": "3000",
    // off | ack | ai — "ai" responde con el agente (Workers AI); "ack" envía un acuse fijo.
    "AUTO_REPLY_MODE": "ai",
    // Modelo de Workers AI (con function calling). Se elige con `pnpm eval:agent`.
    "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
    // Respaldo si el principal falla (caída o límite). Gemma 4: 10/10 en eval; Mistral Small: 5/10 pero rápido y disponible.
    "AI_MODEL_FALLBACK": "@cf/mistralai/mistral-small-3.1-24b-instruct",
    // on | off | default — razonamiento del modelo (Gemma 4: chat_template_kwargs.enable_thinking).
    // "off": eval 10/10 en 2.8 s vs 13.3 s con razonamiento (la extracción y la red de seguridad cubren lo demás).
    "AI_THINKING": "off",
    // Vacío = sin AI Gateway. Con id, las llamadas pasan por el gateway (logs, límites, caché).
    "AI_GATEWAY_ID": ""
  },

  "ai": { "binding": "AI" },

  // Fuente de verdad de los secretos (tipos y aviso en local si falta alguno). Valores en .dev.vars / wrangler secret.
  "secrets": {
    "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lynna",
      // Solo local: la D1 de wrangler dev vive en .wrangler/state.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lynna-media" }],

  "queues": {
    "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound" }],
    "consumers": [
      {
        "queue": "lynna-wa-inbound",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "lynna-wa-inbound-dlq"
      }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationDO"] }],

  // Libera apartados vencidos (lots.reserved_until).
  "triggers": { "crons": ["*/15 * * * *"] },

  "env": {
    "dev": {
      "name": "lynna-api-dev",
      "workers_dev": false,
      "routes": [{ "pattern": "devlynna.igniastudio.mx", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "dev",
        "PUBLIC_URL": "https://devlynna.igniastudio.mx",
        "WHATSAPP_GRAPH_VERSION": "v23.0",
        "DEBOUNCE_MS": "3000",
        "AUTO_REPLY_MODE": "ai",
        "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "AI_MODEL_FALLBACK": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "AI_THINKING": "off",
        "AI_GATEWAY_ID": ""
      },
      "ai": { "binding": "AI" },
      "secrets": {
        "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lynna-dev",
          "database_id": "1166f8cd-687d-48ec-9caa-34ff80bf3e3e",
          "migrations_dir": "migrations"
        }
      ],
      // R2 pendiente: activarlo en el dashboard de la cuenta de Ignia y crear lynna-media-{dev,stg,prod}.
      "queues": {
        "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound-dev" }],
        "consumers": [
          {
            "queue": "lynna-wa-inbound-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "lynna-wa-inbound-dlq-dev"
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    },

    "stg": {
      "name": "lynna-api-stg",
      "workers_dev": false,
      "routes": [{ "pattern": "stglynna.igniastudio.mx", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "stg",
        "PUBLIC_URL": "https://stglynna.igniastudio.mx",
        "WHATSAPP_GRAPH_VERSION": "v23.0",
        "DEBOUNCE_MS": "3000",
        "AUTO_REPLY_MODE": "ai",
        "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "AI_MODEL_FALLBACK": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "AI_THINKING": "off",
        "AI_GATEWAY_ID": ""
      },
      "ai": { "binding": "AI" },
      "secrets": {
        "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lynna-stg",
          "database_id": "d9c40d11-fe9a-4e08-b700-d88842083cc0",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound-stg" }],
        "consumers": [
          {
            "queue": "lynna-wa-inbound-stg",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "lynna-wa-inbound-dlq-stg"
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    },

    "prod": {
      "name": "lynna-api-prod",
      "workers_dev": false,
      "routes": [{ "pattern": "lynna.igniastudio.mx", "custom_domain": true }],
      "vars": {
        "ENVIRONMENT": "prod",
        "PUBLIC_URL": "https://lynna.igniastudio.mx",
        "WHATSAPP_GRAPH_VERSION": "v23.0",
        "DEBOUNCE_MS": "3000",
        "AUTO_REPLY_MODE": "off",
        "AI_MODEL": "@cf/google/gemma-4-26b-a4b-it",
        "AI_MODEL_FALLBACK": "@cf/mistralai/mistral-small-3.1-24b-instruct",
        "AI_THINKING": "off",
        "AI_GATEWAY_ID": ""
      },
      "ai": { "binding": "AI" },
      "secrets": {
        "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lynna-prod",
          "database_id": "7acf9dde-9644-48ff-9130-61808dde0c0e",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound-prod" }],
        "consumers": [
          {
            "queue": "lynna-wa-inbound-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "lynna-wa-inbound-dlq-prod"
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}
