{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nivel superior = LOCAL (`wrangler dev`). Los entornos remotos están en "env":
  //   dev  → lynna-api-dev   (se despliega solo al hacer push a main)
  //   stg  → lynna-api-stg   (tag v*)
  //   prod → lynna-api-prod  (tag v*, con aprobación manual en GitHub)
  // Bindings, vars y secretos NO se heredan entre entornos: cada uno los declara completos.
  "name": "lynna-api",
  "main": "src/index.ts",
  // Debe ser <= a la fecha que soporta el workerd de wrangler Y el de vitest-pool-workers.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_compat"],
  // Cuenta Cloudflare de Ignia Studio. Fijarla evita desplegar por error en otra cuenta.
  "account_id": "76d4525e9674ff3e597084e012f8619e", // Ignia Studio
  "observability": { "enabled": true },
  "workers_dev": false,
  "preview_urls": false,

  "vars": {
    "ENVIRONMENT": "local",
    "WHATSAPP_GRAPH_VERSION": "v23.0",
    // Ventana para agrupar ráfagas de mensajes del mismo prospecto antes de responder.
    "DEBOUNCE_MS": "3000",
    // off | ack — en la Fase 0 aún no hay IA; "ack" envía un acuse fijo para probar el circuito.
    "AUTO_REPLY_MODE": "off"
  },

  // Fuente de verdad de los secretos (tipos y aviso en local si falta alguno). Valores en .dev.vars / wrangler secret.
  "secrets": {
    "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lynna",
      // Solo local: la D1 de wrangler dev vive en .wrangler/state.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],

  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "lynna-media" }],

  "queues": {
    "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound" }],
    "consumers": [
      {
        "queue": "lynna-wa-inbound",
        "max_batch_size": 10,
        "max_batch_timeout": 2,
        "max_retries": 5,
        "dead_letter_queue": "lynna-wa-inbound-dlq"
      }
    ]
  },

  "durable_objects": {
    "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConversationDO"] }],

  // Libera apartados vencidos (lots.reserved_until).
  "triggers": { "crons": ["*/15 * * * *"] },

  "env": {
    "dev": {
      "name": "lynna-api-dev",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "dev",
        "WHATSAPP_GRAPH_VERSION": "v23.0",
        "DEBOUNCE_MS": "3000",
        "AUTO_REPLY_MODE": "off"
      },
      "secrets": {
        "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lynna-dev",
          "database_id": "1166f8cd-687d-48ec-9caa-34ff80bf3e3e",
          "migrations_dir": "migrations"
        }
      ],
      // R2 pendiente: activarlo en el dashboard de la cuenta de Ignia y crear lynna-media-{dev,stg,prod}.
      "queues": {
        "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound-dev" }],
        "consumers": [
          {
            "queue": "lynna-wa-inbound-dev",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "lynna-wa-inbound-dlq-dev"
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    },

    "stg": {
      "name": "lynna-api-stg",
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "stg",
        "WHATSAPP_GRAPH_VERSION": "v23.0",
        "DEBOUNCE_MS": "3000",
        "AUTO_REPLY_MODE": "off"
      },
      "secrets": {
        "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lynna-stg",
          "database_id": "d9c40d11-fe9a-4e08-b700-d88842083cc0",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound-stg" }],
        "consumers": [
          {
            "queue": "lynna-wa-inbound-stg",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "lynna-wa-inbound-dlq-stg"
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    },

    "prod": {
      "name": "lynna-api-prod",
      // Temporal hasta definir dominio propio (routes / custom_domain); entonces workers_dev: false.
      "workers_dev": true,
      "vars": {
        "ENVIRONMENT": "prod",
        "WHATSAPP_GRAPH_VERSION": "v23.0",
        "DEBOUNCE_MS": "3000",
        "AUTO_REPLY_MODE": "off"
      },
      "secrets": {
        "required": ["WHATSAPP_APP_SECRET", "WHATSAPP_VERIFY_TOKEN", "WHATSAPP_ACCESS_TOKEN", "ADMIN_API_TOKEN"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "lynna-prod",
          "database_id": "7acf9dde-9644-48ff-9130-61808dde0c0e",
          "migrations_dir": "migrations"
        }
      ],
      "queues": {
        "producers": [{ "binding": "WA_INBOUND", "queue": "lynna-wa-inbound-prod" }],
        "consumers": [
          {
            "queue": "lynna-wa-inbound-prod",
            "max_batch_size": 10,
            "max_batch_timeout": 2,
            "max_retries": 5,
            "dead_letter_queue": "lynna-wa-inbound-dlq-prod"
          }
        ]
      },
      "durable_objects": {
        "bindings": [{ "name": "CONVERSATION", "class_name": "ConversationDO" }]
      },
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}
